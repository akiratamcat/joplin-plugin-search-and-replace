#: src/settings.ts
msgid "Search & Replace i18n"
msgstr ""

#: src/settings.ts
msgid "GUI Preference"
msgstr "Bevorzugte Oberfläche"

#: src/settings.ts
msgid "If you don't like the panel, you can switch to a popup dialog instead."
msgstr "Wenn Ihnen das Seitenpanel nicht gefällt, können Sie stattdessen zu einem Popup-Dialog wechseln."

#: src/settings.ts
msgid "Open a panel (default, recommended)"
msgstr "Panel öffnen (Standard, empfohlen)"

#: src/settings.ts
msgid "Open a dialog (like in previous versions)"
msgstr "Dialog öffnen (wie in früheren Versionen)"

#: src/index.ts src/panel.ts src/dialog.ts
msgid "Search and replace"
msgstr "Suchen und Ersetzen"

#: src/index.ts
msgid "Find previous"
msgstr "Vorheriges suchen"

#: src/index.ts
msgid "Find next"
msgstr "Nächstes suchen"

#: src/index.ts src/panel.ts src/dialog.ts
msgid "Replace"
msgstr "Ersetzen"

#: src/index.ts src/panel.ts
msgid "Replace all"
msgstr "Alle ersetzen"

#: src/panel.ts
msgid "Close"
msgstr "Schließen"

#: src/panel.ts
msgid "Please return to the markdown editor."
msgstr "Bitte kehren Sie zum Markdown-Editor zurück."

#: src/panel.ts src/dialog.ts
msgid "Find"
msgstr "Suchen"

#: src/panel.ts
msgid "Previous"
msgstr "Vorheriges"

#: src/panel.ts
msgid "Next"
msgstr "Nächstes"

#: src/panel.ts
msgid "(all)"
msgstr "(alle)"

#: src/panel.ts
msgid "Regex:"
msgstr "Regex:"

#: src/panel.ts src/dialog.ts
msgid "Options:"
msgstr "Optionen:"

#: src/panel.ts src/dialog.ts
msgid "Wrap around"
msgstr "Am Ende von vorne beginnen"

#: src/panel.ts src/dialog.ts
msgid "Match case"
msgstr "Groß-/Kleinschreibung beachten"

#: src/panel.ts src/dialog.ts
msgid "Match whole words only"
msgstr "Nur ganze Wörter"

#: src/panel.ts src/dialog.ts
msgid "Preserve case"
msgstr "Groß-/Kleinschreibung beibehalten"

#: src/panel.ts src/dialog.ts
msgid "Use 'multi line' flag"
msgstr "„Multiline“-Flag verwenden"

#: src/panel.ts src/dialog.ts
msgid "Literal search"
msgstr "Einfache Suche"

#: src/panel.ts src/dialog.ts
msgid "Use Wildcards"
msgstr "Platzhalter verwenden"

#: src/panel.ts src/dialog.ts
msgid "Use Regular Expression"
msgstr "Reguläre Ausdrücke verwenden"

#: src/panel.ts
msgid "Show help"
msgstr "Hilfe anzeigen"

#: src/panel.ts
msgid "When you reach the end of the note, it will wrap around to the beginning of the note (and vice versa)."
msgstr "Wenn das Ende der Notiz erreicht ist, wird die Suche am Anfang der Notiz fortgesetzt (und umgekehrt)."

#: src/panel.ts
msgid "With wildcards enabled, you can search using <code>?</code> (any <b>one</b> character) and <code>*</code> (any characters, zero or more). Escape them like so: <code>\\*</code>, <code>\\?</code>"
msgstr "Mit aktivierten Platzhaltern können Sie mit <code>?</code> (genau <b>ein</b> beliebiges Zeichen) und <code>*</code> (beliebige Zeichen, null oder mehr) suchen. Maskieren Sie sie so: <code>\\*</code>, <code>\\?</code>"

#: src/panel.ts
msgid "If you enable regular expressions, it's going to use JavaScript's regex. You can also use groups in the replacement text using <code>$1</code>, <code>$2</code>, and so on. Tip: Use regex101.com"
msgstr "Wenn Sie reguläre Ausdrücke aktivieren, werden die regulären Ausdrücke von JavaScript verwendet. Im Ersetzungstext können Sie mit <code>$1</code>, <code>$2</code> usw. auf Gruppen verweisen. Tipp: Nutzen Sie regex101.com"

#: src/panel.ts
msgid "This plugin internally translates every search pattern to a regular expression. You can preview the used regex."
msgstr "Dieses Plugin übersetzt intern jedes Suchmuster in einen regulären Ausdruck. Sie können den verwendeten regulären Ausdruck in der Vorschau sehen."

#: src/cmPlugin.ts
msgid "Empty pattern"
msgstr "Leeres Suchmuster"

#: src/cmPlugin.ts
msgid "Please enter a search pattern."
msgstr "Bitte geben Sie ein Suchmuster ein."

#: src/cmPlugin.ts
msgid "Invalid regular expression"
msgstr "Ungültiger regulärer Ausdruck"

#: src/cmPlugin.ts
msgid "No more occurences found"
msgstr "Keine weiteren Vorkommen gefunden"

#: src/cmPlugin.ts
#, c-format
msgid "\"%s\" couldn't be found."
msgstr "„%s“ wurde nicht gefunden."

#: src/cmPlugin.ts
msgid "No occurences found"
msgstr "Keine Vorkommen gefunden"

#: src/cmPlugin.ts
#, c-format
msgid "\"%s\" couldn't be found. Nothing was replaced."
msgstr "„%s“ wurde nicht gefunden. Es wurde nichts ersetzt."
