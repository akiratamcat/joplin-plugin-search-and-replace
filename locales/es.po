#: src/settings.ts
msgid "Search & Replace i18n"
msgstr ""

#: src/settings.ts
msgid "GUI Preference"
msgstr "Preferencia de interfaz"

#: src/settings.ts
msgid "If you don't like the panel, you can switch to a popup dialog instead."
msgstr "Si no le gusta el panel, puede cambiar a un cuadro de diálogo emergente."

#: src/settings.ts
msgid "Open a panel (default, recommended)"
msgstr "Abrir un panel (predeterminado, recomendado)"

#: src/settings.ts
msgid "Open a dialog (like in previous versions)"
msgstr "Abrir un cuadro de diálogo (como en versiones anteriores)"

#: src/index.ts src/panel.ts src/dialog.ts
msgid "Search and replace"
msgstr "Buscar y reemplazar"

#: src/index.ts
msgid "Find previous"
msgstr "Buscar anterior"

#: src/index.ts
msgid "Find next"
msgstr "Buscar siguiente"

#: src/index.ts src/panel.ts src/dialog.ts
msgid "Replace"
msgstr "Reemplazar"

#: src/index.ts src/panel.ts
msgid "Replace all"
msgstr "Reemplazar todo"

#: src/panel.ts
msgid "Close"
msgstr "Cerrar"

#: src/panel.ts
msgid "Please return to the markdown editor."
msgstr "Vuelva al editor Markdown."

#: src/panel.ts src/dialog.ts
msgid "Find"
msgstr "Buscar"

#: src/panel.ts
msgid "Previous"
msgstr "Anterior"

#: src/panel.ts
msgid "Next"
msgstr "Siguiente"

#: src/panel.ts
msgid "(all)"
msgstr "(todo)"

#: src/panel.ts
msgid "Regex:"
msgstr "Regex:"

#: src/panel.ts src/dialog.ts
msgid "Options:"
msgstr "Opciones:"

#: src/panel.ts src/dialog.ts
msgid "Wrap around"
msgstr "Volver al principio"

#: src/panel.ts src/dialog.ts
msgid "Match case"
msgstr "Coincidir mayúsculas y minúsculas"

#: src/panel.ts src/dialog.ts
msgid "Match whole words only"
msgstr "Solo palabras completas"

#: src/panel.ts src/dialog.ts
msgid "Preserve case"
msgstr "Conservar mayúsculas y minúsculas"

#: src/panel.ts src/dialog.ts
msgid "Use 'multi line' flag"
msgstr "Usar el indicador «multilínea»"

#: src/panel.ts src/dialog.ts
msgid "Literal search"
msgstr "Búsqueda literal"

#: src/panel.ts src/dialog.ts
msgid "Use Wildcards"
msgstr "Usar comodines"

#: src/panel.ts src/dialog.ts
msgid "Use Regular Expression"
msgstr "Usar expresiones regulares"

#: src/panel.ts
msgid "Show help"
msgstr "Mostrar ayuda"

#: src/panel.ts
msgid "When you reach the end of the note, it will wrap around to the beginning of the note (and vice versa)."
msgstr "Al llegar al final de la nota, la búsqueda continuará desde el principio de la nota (y viceversa)."

#: src/panel.ts
msgid "With wildcards enabled, you can search using <code>?</code> (any <b>one</b> character) and <code>*</code> (any characters, zero or more). Escape them like so: <code>\\*</code>, <code>\\?</code>"
msgstr "Con los comodines activados, puede buscar usando <code>?</code> (<b>un</b> carácter cualquiera) y <code>*</code> (cualquier cantidad de caracteres, incluso ninguno). Escápelos así: <code>\\*</code>, <code>\\?</code>"

#: src/panel.ts
msgid "If you enable regular expressions, it's going to use JavaScript's regex. You can also use groups in the replacement text using <code>$1</code>, <code>$2</code>, and so on. Tip: Use regex101.com"
msgstr "Si activa las expresiones regulares, se usarán las expresiones regulares de JavaScript. En el texto de reemplazo puede usar grupos con <code>$1</code>, <code>$2</code>, etc. Consejo: use regex101.com"

#: src/panel.ts
msgid "This plugin internally translates every search pattern to a regular expression. You can preview the used regex."
msgstr "Este complemento convierte internamente cada patrón de búsqueda en una expresión regular. Puede ver una vista previa de la expresión regular utilizada."

#: src/cmPlugin.ts
msgid "Empty pattern"
msgstr "Patrón vacío"

#: src/cmPlugin.ts
msgid "Please enter a search pattern."
msgstr "Introduzca un patrón de búsqueda."

#: src/cmPlugin.ts
msgid "Invalid regular expression"
msgstr "Expresión regular no válida"

#: src/cmPlugin.ts
msgid "No more occurences found"
msgstr "No se encontraron más coincidencias"

#: src/cmPlugin.ts
#, c-format
msgid "\"%s\" couldn't be found."
msgstr "No se encontró «%s»."

#: src/cmPlugin.ts
msgid "No occurences found"
msgstr "No se encontraron coincidencias"

#: src/cmPlugin.ts
#, c-format
msgid "\"%s\" couldn't be found. Nothing was replaced."
msgstr "No se encontró «%s». No se reemplazó nada."
